pipeline {
    agent any

    environment {
        IMAGE_NAME = "stage-gateway"
        IMAGE_TAG  = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'dev',
                    credentialsId: 'git_ssh',
                    url: 'https://github.com/zayedhamadi/microservice_intern.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('gateway') {
                    script {
                        docker.build("${IMAGE_NAME}:${IMAGE_TAG}")
                    }
                }
            }
        }
    }

    post {
        success { echo "Build réussi pour gateway #${env.BUILD_NUMBER}" }
        failure { echo "Échec du pipeline gateway #${env.BUILD_NUMBER}" }
    }
}