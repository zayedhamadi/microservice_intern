pipeline {
    agent any

    environment {
        IMAGE_NAME = "stage-recrutement-service"
        IMAGE_TAG  = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'dev',
                    credentialsId: 'github-account',
                    url: 'https://github.com/zayedhamadi/microservice_intern.git'
            }
        }

        stage('Run Tests') {
            steps {
                dir('recrutement') {
                    script {
                        docker.image('maven:3.9-eclipse-temurin-21').inside('-v $HOME/.m2:/root/.m2') {
                            sh 'mvn clean test'
                        }
                    }
                }
            }
            post {
                always {
                    junit 'recrutement/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('recrutement') {
                    script {
                        docker.image('maven:3.9-eclipse-temurin-21').inside("--network stage-network -v \$HOME/.m2:/root/.m2") {
                            withSonarQubeEnv('sonarqube') {
                                sh 'mvn sonar:sonar -Dsonar.projectKey=stage-recrutement-service'
                            }
                        }
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('recrutement') {
                    script {
                        docker.build("${IMAGE_NAME}:${IMAGE_TAG}")
                    }
                }
            }
        }
    }

    post {
        success { echo "Build et tests réussis pour recrutement-service #${env.BUILD_NUMBER}" }
        failure { echo "Échec du pipeline recrutement-service #${env.BUILD_NUMBER}" }
    }
}
