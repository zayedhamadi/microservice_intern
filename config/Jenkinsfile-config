pipeline {
    agent any

    environment {
        IMAGE_NAME = "stage-config-server"
        IMAGE_TAG  = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'dev',
                    credentialsId: 'github-account',
                    url: 'https://github.com/zayedhamadi/microservice_intern.git'
            }
        }
        stage('SonarQube Analysis') {
            steps {
                dir('config') {
                    script {
                        docker.image('maven:3.9-eclipse-temurin-21').inside("--network stage-network -v \$HOME/.m2:/root/.m2") {
                            withSonarQubeEnv('sonarqube') {
                                sh 'mvn clean verify sonar:sonar -Dsonar.projectKey=stage-config-server'
                            }
                        }
                    }
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('config') {
                    script {
                        docker.build("${IMAGE_NAME}:${IMAGE_TAG}")
                    }
                }
            }
        }
    }

    post {
        success { echo "Build réussi pour config-server #${env.BUILD_NUMBER}" }
        failure { echo "Échec du pipeline config-server #${env.BUILD_NUMBER}" }
    }
}
